# ShareMeal Environment Configuration Template
# Copy this file to server/.env and fill in your actual credentials

PORT=5001
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
# DATABASE_URL=postgresql://postgres.your_project_id:your_db_password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.Your_project_id:[YOUR_PASSWORD]&@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres











JWT_SECRET=replace_with_your_own_long_random_secret_string
JWT_EXPIRES_IN=7d

# Use the same Web application OAuth client ID in server/.env and client/.env.
# Authorize http://localhost:5173 in Google Cloud Console as a JavaScript origin.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Gemini API for the ShareMeal help assistant
GEMINI_API_KEY=your_gemini_api_key
# Models are tried in this order; overloaded (503) or missing (404) models fall
# through to the next. Leave GEMINI_FAST_MODEL empty to use gemini-3.5-flash.
GEMINI_FAST_MODEL=gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# low = fast, good answers; high = slower, deeper reasoning; off = no thinking
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=4096
# If a model has not started answering after this many ms, also ask the next
# model; at most GEMINI_MAX_PARALLEL requests per question. Every parallel
# request uses quota (free tier: 20 requests/day per model).
GEMINI_HEDGE_DELAY_MS=6000
GEMINI_MAX_PARALLEL=2

# Email / SMTP Configuration (e.g. Gmail App Password)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password

# Supabase Storage Configuration (for cloud image uploads)
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AES-256 Database Field Encryption Secret (32-character key)
ENCRYPTION_SECRET=your_32_character_encryption_secret_key!

# Receiver wallet top-ups
# Only "sandbox" is implemented: it simulates a checkout and credits TEST money
# (stored with is_simulated = true). It is disabled when NODE_ENV=production
# unless WALLET_SANDBOX_ENABLED=true. A real gateway (e.g. SSLCommerz / bKash)
# needs its own provider in services/paymentProvider.js plus merchant
# credentials here (never in client/.env).
WALLET_PAYMENT_PROVIDER=sandbox
WALLET_SANDBOX_ENABLED=false
